---
import "../styles/global.css";
import { SITE, url } from "../consts";

const { title, description, current } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;

// 首页用满配背景，内页收着来
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname.replace(/\/$/, "");
const isHome = here === base || here === "";

const nav = [
  { href: url("/"), label: "大厅", key: "home" },
  { href: url("/columns/"), label: "专栏", key: "columns" },
  { href: url("/tags/"), label: "标签", key: "tags" },
  { href: url("/archive/"), label: "归档", key: "archive" },
  { href: url("/about/"), label: "关于", key: "about" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? SITE.description} />
    <meta name="theme-color" content="#14151d" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · RSS`} href={url("/rss.xml")} />
  </head>
  <body class={isHome ? "page-home" : "page-inner"}>
    <div class="bg-media" style={`--poster: url(${url("/bg/poster.jpg")})`} aria-hidden="true">
      <video autoplay muted loop playsinline preload="metadata" poster={url("/bg/poster.jpg")}>
        <source src={url("/bg/bg.mp4")} type="video/mp4" />
      </video>
    </div>
    <div class="atmosphere" aria-hidden="true"></div>

    <header class="site-header container">
      <a class="brand" href={url("/")}>
        <strong>{SITE.title}</strong>
        <span>{SITE.tagline}</span>
      </a>
      <nav aria-label="主导航">
        {
          nav.map((item) => (
            <a href={item.href} class={item.key === current ? "current" : ""} aria-current={item.key === current ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer container">
      <span>© {new Date().getFullYear()} {SITE.author}</span>
      <span>认真生活，慢慢记录。</span>
      <a href={url("/rss.xml")}>RSS 订阅</a>
    </footer>

    {
      isHome && (
        <script is:inline>
          // 往下滚时让壁纸淡下去，正文回到深色底
          const setDim = () => {
            const v = Math.min(window.scrollY / 620, 1).toFixed(3);
            document.documentElement.style.setProperty("--scroll-dim", v);
          };
          setDim();
          window.addEventListener("scroll", setDim, { passive: true });
        </script>
      )
    }
  </body>
</html>
