---
import Base from "../../layouts/Base.astro";
import { url } from "../../consts";
import { COLUMNS, getPosts, excerptOf, shortDate, columnSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  // 五个专栏都生成页面，即使还没有文章，避免首页卡片点进去 404
  return COLUMNS.map((c) => ({
    params: { column: columnSlug(c.name) },
    props: { name: c.name, desc: c.desc, posts: posts.filter((p) => p.data.column === c.name) },
  }));
}

const { name, desc, posts } = Astro.props;
---

<Base title={name} current="columns">
  <section class="hero" style="padding-block:56px 24px">
    <p class="eyebrow">专栏</p>
    <h1 style="font-size:clamp(26px,4vw,38px)"><span>{name}</span></h1>
    <p class="hero-description">{desc}　共 {posts.length} 篇。</p>
  </section>

  <nav class="column-chips" aria-label="专栏切换">
    {
      COLUMNS.map((c) => (
        <a
          href={url(`/columns/${columnSlug(c.name)}/`)}
          class={c.name === name ? "active" : ""}
          aria-current={c.name === name ? "page" : undefined}
        >
          {c.name}
        </a>
      ))
    }
  </nav>

  {
    posts.length ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time>
            <div>
              <h3><a href={url(`/posts/${post.id}/`)}>{post.data.title}</a></h3>
              <p>{excerptOf(post)}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">这个专栏还没有文章。</p>
    )
  }
</Base>
